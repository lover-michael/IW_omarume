{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "POSTGRES_URL",
        "POSTGRES_URL_NON_POOLING",
        "PGHOST",
        "PGUSER",
        "PGPASSWORD",
        "PGDATABASE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
